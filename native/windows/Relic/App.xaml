<Application x:Class="Relic.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RelicControlInk" Color="#1B1B1A" />
          <SolidColorBrush x:Key="RelicControlCard" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RelicControlLine" Color="#DEDBD4" />
          <SolidColorBrush x:Key="RelicControlHover" Color="#EFEEEA" />
          <SolidColorBrush x:Key="RelicControlPressed" Color="#E7E5DF" />
          <SolidColorBrush x:Key="RelicControlDisabled" Color="#B8B5AF" />
          <SolidColorBrush x:Key="RelicControlMuted" Color="#8F8C86" />
          <SolidColorBrush x:Key="RelicControlSecondary" Color="#5A5853" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#1B1B1A" />
          <SolidColorBrush x:Key="ComboBoxEditableDropDownGlyphForeground" Color="#1B1B1A" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#1B1B1A" />
          <SolidColorBrush x:Key="RelicScrollThumb" Color="#8F8C86" Opacity="0.35" />
          <SolidColorBrush x:Key="RelicScrollThumbHover" Color="#8F8C86" Opacity="0.55" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="RelicControlInk" Color="#ECEAE5" />
          <SolidColorBrush x:Key="RelicControlCard" Color="#252523" />
          <SolidColorBrush x:Key="RelicControlLine" Color="#3A3936" />
          <SolidColorBrush x:Key="RelicControlHover" Color="#262624" />
          <SolidColorBrush x:Key="RelicControlPressed" Color="#2F2E2B" />
          <SolidColorBrush x:Key="RelicControlDisabled" Color="#5F5D58" />
          <SolidColorBrush x:Key="RelicControlMuted" Color="#8A877F" />
          <SolidColorBrush x:Key="RelicControlSecondary" Color="#B8B5AE" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#ECEAE5" />
          <SolidColorBrush x:Key="ComboBoxEditableDropDownGlyphForeground" Color="#ECEAE5" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#ECEAE5" />
          <SolidColorBrush x:Key="RelicScrollThumb" Color="#8A877F" Opacity="0.35" />
          <SolidColorBrush x:Key="RelicScrollThumbHover" Color="#8A877F" Opacity="0.55" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Use the reference's text face explicitly. XamlAutoFontFamily can
           select a different Segoe optical family even at the same size. -->
      <FontFamily x:Key="RelicUIFont">Segoe UI Variable Text, Segoe UI, PingFang SC, Microsoft YaHei UI, Noto Sans SC</FontFamily>
      <!-- app.css: 10px non-overlay scrollbars; thumb has a 3px transparent
           border and clips its .35/.55 ink-3 background to the padding box. -->
      <Style x:Key="RelicScrollThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Background" Value="{ThemeResource RelicScrollThumb}" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbPaint" Background="{TemplateBinding Background}" BackgroundSizing="InnerBorderEdge" BorderBrush="#00000000" BorderThickness="3" CornerRadius="8">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ThumbPaint.Background" Value="{ThemeResource RelicScrollThumbHover}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ThumbPaint.Background" Value="{ThemeResource RelicScrollThumbHover}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <ControlTemplate x:Key="RelicScrollPageButtonTemplate" TargetType="RepeatButton">
        <Border Background="#00000000" />
      </ControlTemplate>
      <Style x:Key="RelicScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Root" Background="{TemplateBinding Background}">
              <!-- These are the Windows App SDK ScrollBar's actual template
                   parts. The native control lays out and wires its track and
                   Thumb; no separate offset/drag calculation is substituted. -->
              <Grid x:Name="HorizontalRoot" Height="10" Background="#00000000">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="0" Width="0" Height="10" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Background="#00000000" BorderBrush="#00000000" BorderThickness="0" Template="{StaticResource RelicScrollPageButtonTemplate}" />
                <Thumb x:Name="HorizontalThumb" Grid.Column="1" Height="10" Style="{StaticResource RelicScrollThumbStyle}" />
                <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="2" Height="10" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Background="#00000000" BorderBrush="#00000000" BorderThickness="0" Template="{StaticResource RelicScrollPageButtonTemplate}" />
              </Grid>
              <Grid x:Name="VerticalRoot" Width="10" Background="#00000000">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="0" Height="0" Width="10" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Background="#00000000" BorderBrush="#00000000" BorderThickness="0" Template="{StaticResource RelicScrollPageButtonTemplate}" />
                <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="10" Style="{StaticResource RelicScrollThumbStyle}" />
                <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="2" Width="10" MinWidth="0" MinHeight="0" IsTabStop="False" AllowFocusOnInteraction="False" Interval="50" Background="#00000000" BorderBrush="#00000000" BorderThickness="0" Template="{StaticResource RelicScrollPageButtonTemplate}" />
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="RelicScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}">
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- No RowSpan/ColumnSpan: a visible native bar takes space;
                     Auto visibility returns it when the content fits. -->
                <ScrollContentPresenter x:Name="ScrollContentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" SizesContentToTemplatedParent="False" />
                <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" Width="10" Orientation="Vertical" Style="{StaticResource RelicScrollBarStyle}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" />
                <ScrollBar x:Name="HorizontalScrollBar" Grid.Row="1" Height="10" Orientation="Horizontal" Style="{StaticResource RelicScrollBarStyle}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableWidth}" Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource RelicUIFont}" /></Style>
      <Style TargetType="RichTextBlock"><Setter Property="FontFamily" Value="{StaticResource RelicUIFont}" /></Style>
      <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource RelicUIFont}" /></Style>
      <!-- Native template: retain Button/UIA/keyboard semantics while matching
           the reference's flat paint instead of the default Fluent bevel. -->
      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RelicUIFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource RelicControlInk}" />
        <Setter Property="Background" Value="{ThemeResource RelicControlCard}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RelicControlLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Presenter.Background" Value="{ThemeResource RelicControlHover}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Presenter.Background" Value="{ThemeResource RelicControlPressed}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource RelicControlDisabled}" /></VisualState.Setters></VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </ContentPresenter>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The chip's selected state supplies its hover resources too, matching
           the later .chip-btn.on rule. Text and SVG paths inherit this actual
           ContentPresenter foreground through the native visual tree. -->
      <ControlTemplate x:Key="RelicChipButtonTemplate" TargetType="Button">
        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{TemplateBinding Background}" BackgroundSizing="OuterBorderEdge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Foreground="{TemplateBinding Foreground}">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Presenter.Background" Value="{ThemeResource RelicChipHoverBackground}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource RelicChipHoverForeground}" /></VisualState.Setters></VisualState>
              <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Presenter.Background" Value="{ThemeResource RelicChipHoverBackground}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource RelicChipHoverForeground}" /></VisualState.Setters></VisualState>
              <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Foreground" Value="{ThemeResource RelicControlDisabled}" /></VisualState.Setters></VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
        </ContentPresenter>
      </ControlTemplate>
      <Style x:Key="RelicSwatchStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- CSS backgrounds extend under a transparent border. Keep the
                 entire 24px color disc, including during hover and press. -->
            <Border Background="{TemplateBinding Background}" BackgroundSizing="OuterBorderEdge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="RelicResizeThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid x:Name="ResizeSurface" Background="{TemplateBinding Background}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ResizeSurface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Target="ResizeSurface.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ResizeSurface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Target="ResizeSurface.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="RelicPaneTabStyle" TargetType="SelectorBarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="SelectorBarItem">
            <Grid x:Name="PART_ContainerRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CombinedStates">
                  <VisualState x:Name="UnselectedNormal" />
                  <VisualState x:Name="UnselectedPointerOver"><VisualState.Setters><Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource RelicControlHover}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="UnselectedPressed"><VisualState.Setters><Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource RelicControlPressed}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="SelectedNormal"><VisualState.Setters><Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource RelicControlPressed}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource RelicControlPressed}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="PART_ContainerRoot.Background" Value="{ThemeResource RelicControlPressed}" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="RelicComposerMenuItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource RelicControlInk}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="MenuFlyoutItem">
            <ContentPresenter x:Name="ComposerMenuRow" Content="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ComposerMenuRow.Background" Value="{ThemeResource RelicControlHover}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ComposerMenuRow.Background" Value="{ThemeResource RelicControlHover}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ComposerMenuRow.Foreground" Value="{ThemeResource RelicControlDisabled}" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </ContentPresenter>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="RelicComposerCheckStyle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="13" /><Setter Property="Height" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Border x:Name="CheckSurface" CornerRadius="2" Background="{ThemeResource RelicControlCard}" BorderBrush="#767676" BorderThickness="1" />
              <Path x:Name="CheckMark" Data="M 3,6.5 L 5.2,9 L 10,3.5" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Target="CheckSurface.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Target="CheckMark.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="RelicMenuItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource RelicControlInk}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuFlyoutItem">
              <Grid x:Name="MenuRow" Padding="{TemplateBinding Padding}" ColumnSpacing="10" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" Text="{TemplateBinding Text}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}" LineHeight="20.8" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding KeyboardAcceleratorTextOverride}" FontFamily="Cascadia Code" FontSize="11" Foreground="{ThemeResource RelicControlMuted}" VerticalAlignment="Center" />
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="MenuRow.Background" Value="{ThemeResource RelicControlHover}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="MenuRow.Background" Value="{ThemeResource RelicControlPressed}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="MenuLabel.Foreground" Value="{ThemeResource RelicControlDisabled}" /></VisualState.Setters></VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource RelicControlCard}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RelicControlLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="250" />
      </Style>
      <Style TargetType="MenuFlyoutSeparator">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutSeparator"><Border Height="1" Margin="6,4" Background="{ThemeResource RelicControlLine}" /></ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
