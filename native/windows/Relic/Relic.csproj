<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Relic</RootNamespace><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Relic.ico</ApplicationIcon>
    <Platforms>x64</Platforms><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI><EnableMsixTooling>true</EnableMsixTooling><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Ship the precompiled code without repeatedly optimizing it on a
         background tiering thread after the desktop has become idle. -->
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">false</TieredCompilation>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <ProjectReference Include="../Relic.Core/Relic.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every parsed response keeps a copy of its JSON and a token table the
         size of the payload. Above 85,000 bytes those went to the large object
         heap, whose budget then started a full (gen2) collection about once a
         second while switching chats. Up to 1 MB they now die young instead. -->
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="1048576" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../plugins/relic/app/static/icon.svg" Link="Assets/Relic.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
