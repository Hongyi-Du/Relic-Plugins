{
  "description": "Inject selected organization context, observe episodes and gate supported local tool calls using adopted protocols. Review and trust these hooks in Codex before relying on enforcement.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','hook.py'),run_name='__main__')\"", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','hook.py'),run_name='__main__')\"", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','hook.py'),run_name='__main__')\"", "timeout": 5, "statusMessage": "Checking adopted organization protocols"}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','hook.py'),run_name='__main__')\"", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','hook.py'),run_name='__main__')\"", "timeout": 5}]}]
  }
}
