{
  "description": "Relic: organization context, protocol enforcement on tool calls, peer message delivery, reflection prompts.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}],
    "SubagentStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20, "onFailure": "block"}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}],
    "PostToolUseFailure": [{"matcher": "*", "hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}],
    "SubagentStop": [{"matcher": "*", "hooks": [{"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/relic_hook.py"], "timeout": 20}]}]
  }
}
