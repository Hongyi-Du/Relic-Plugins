{
  "description": "Relic (Claude Code and Codex): organization context, protocol enforcement on tool calls, peer message delivery, reflection prompts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20,
            "statusMessage": "Checking Relic protocols"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PLUGIN_ROOT') or os.environ['PLUGIN_ROOT'],'hooks','relic_hook.py'),run_name='__main__')\"",
            "timeout": 20
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
